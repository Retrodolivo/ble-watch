#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import has_part_picked
import can_bridge_by_name

component C_100pF_0402:
    """100 pF 50 V C0G 0402 (RF decoupling)"""
    trait is_atomic_part<manufacturer="Murata", partnumber="GRM1555C1H101JA01D", footprint="C_0402_1005Metric.kicad_mod", symbol="C_100pF_0402.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C77177", manufacturer="Murata", partno="GRM1555C1H101JA01D">
    trait has_designator_prefix<prefix="C">
    trait can_bridge_by_name<input_name="p1", output_name="p2">

    signal p1 ~ pin 1
    signal p2 ~ pin 2
