#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import has_part_picked
import can_bridge_by_name

component C_4u7_0603:
    """4.7 uF 10 V X5R 0603"""
    trait is_atomic_part<manufacturer="Murata", partnumber="GRM188R61A475KE15D", footprint="C_0603_1608Metric.kicad_mod", symbol="C_4u7_0603.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C71633", manufacturer="Murata", partno="GRM188R61A475KE15D">
    trait has_designator_prefix<prefix="C">
    trait can_bridge_by_name<input_name="p1", output_name="p2">

    signal p1 ~ pin 1
    signal p2 ~ pin 2
