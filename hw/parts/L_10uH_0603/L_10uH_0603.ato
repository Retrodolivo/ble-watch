#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import has_part_picked
import can_bridge_by_name

component L_10uH_0603:
    """10 uH 0603 power inductor (nRF52840 DC/DC) - VERIFY part"""
    trait is_atomic_part<manufacturer="Murata", partnumber="LQM18DZ100M70L", footprint="L_0603_1608Metric.kicad_mod", symbol="L_10uH_0603.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C3911082", manufacturer="Murata", partno="LQM18DZ100M70L">
    trait has_designator_prefix<prefix="L">
    trait can_bridge_by_name<input_name="p1", output_name="p2">

    signal p1 ~ pin 1
    signal p2 ~ pin 2
