#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import has_part_picked
import can_bridge_by_name

component R_1M_0402:
    """1 MOhm 1% 0402 (battery voltage divider)"""
    trait is_atomic_part<manufacturer="YAGEO", partnumber="RC0402FR-071ML", footprint="R_0402_1005Metric.kicad_mod", symbol="R_1M_0402.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C138033", manufacturer="YAGEO", partno="RC0402FR-071ML">
    trait has_designator_prefix<prefix="R">
    trait can_bridge_by_name<input_name="p1", output_name="p2">

    signal p1 ~ pin 1
    signal p2 ~ pin 2
