#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import has_part_picked
import can_bridge_by_name

component C_0p8pF_0402:
    """0.8 pF C0G 0402 (RF matching)"""
    trait is_atomic_part<manufacturer="Murata", partnumber="GJM1555C1HR80BB01D", footprint="C_0402_1005Metric.kicad_mod", symbol="C_0p8pF_0402.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C76915", manufacturer="Murata", partno="GJM1555C1HR80BB01D">
    trait has_designator_prefix<prefix="C">
    trait can_bridge_by_name<input_name="p1", output_name="p2">

    signal p1 ~ pin 1
    signal p2 ~ pin 2
