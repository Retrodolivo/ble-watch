#pragma experiment("TRAITS")
import is_atomic_part
import has_designator_prefix
import has_part_picked
import can_bridge_by_name

component R_0R_0402:
    """0 Ohm jumper 0402 (antenna tuning placeholder)"""
    trait is_atomic_part<manufacturer="YAGEO", partnumber="RC0402JR-070RL", footprint="R_0402_1005Metric.kicad_mod", symbol="R_0R_0402.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C60485", manufacturer="YAGEO", partno="RC0402JR-070RL">
    trait has_designator_prefix<prefix="R">
    trait can_bridge_by_name<input_name="p1", output_name="p2">

    signal p1 ~ pin 1
    signal p2 ~ pin 2
