/*
 * App overlay for the nRF52840 DK, applied after the board and shield devicetree.
 */

#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/*
 * BUSY (D7, P1.08): add a pull-down. Without the panel the pin floats and can
 * read "busy" forever, which blocks the SSD16xx driver init before main().
 * With the panel connected, the controller drives BUSY, so the weak pull-down
 * (about 13 kOhm) changes nothing.
 */
&ssd16xx_waveshare_epaper_gdeh0154a07 {
	busy-gpios = <&arduino_header ARDUINO_HEADER_R3_D7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
};
