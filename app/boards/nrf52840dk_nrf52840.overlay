/*
 * App overlay for the nRF52840 DK, applied after the board devicetree.
 *
 * Binary LED face: 11 yellow LEDs on the Arduino header, each driven by one
 * PWM channel (wiring: pin -> resistor -> LED -> GND, so "high" = on).
 * Pinout table: docs/hardware.md.
 *
 * PWM pins are set through pinctrl (NRF_PSEL), which takes real nRF pin
 * numbers, not Arduino names. The Arduino name is in each comment.
 *
 * The nRF52840 has 4 PWM instances with 4 channels each. We use 11 channels:
 *   pwm0 ch0-3: hours   bit 0-3
 *   pwm1 ch0:   hours   bit 4
 *   pwm1 ch1-3: minutes bit 0-2
 *   pwm2 ch0-2: minutes bit 3-5
 */

#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>
#include <zephyr/dt-bindings/sensor/lis2dw12.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/*
 * The board uses pwm0 channel 0 for DK LED1 (P0.13), as a "pwm-leds" node.
 * The face needs pwm0, so remove the board's node and its alias. LED1 is
 * the green status LED (node status_led, below).
 */
/delete-node/ &{/pwmleds};

/ {
	aliases {
		/delete-property/ pwm-led0;
	};

	/*
	 * Child order = bit number: the first child is bit 0 (value 1).
	 * 1 ms period = 1 kHz, far too fast to see flicker.
	 */
	hour_leds: hour_leds {
		compatible = "pwm-leds";

		hour_bit0 { pwms = <&pwm0 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "H1"; };
		hour_bit1 { pwms = <&pwm0 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "H2"; };
		hour_bit2 { pwms = <&pwm0 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "H4"; };
		hour_bit3 { pwms = <&pwm0 3 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "H8"; };
		hour_bit4 { pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "H16"; };
	};

	minute_leds: minute_leds {
		compatible = "pwm-leds";

		minute_bit0 { pwms = <&pwm1 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "M1"; };
		minute_bit1 { pwms = <&pwm1 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "M2"; };
		minute_bit2 { pwms = <&pwm1 3 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "M4"; };
		minute_bit3 { pwms = <&pwm2 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "M8"; };
		minute_bit4 { pwms = <&pwm2 1 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "M16"; };
		minute_bit5 { pwms = <&pwm2 2 PWM_MSEC(1) PWM_POLARITY_NORMAL>; label = "M32"; };
	};
};

&pinctrl {
	face_pwm0_default: face_pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 8)>,	/* D7: H1 */
				<NRF_PSEL(PWM_OUT1, 1, 7)>,	/* D6: H2 */
				<NRF_PSEL(PWM_OUT2, 1, 6)>,	/* D5: H4 */
				<NRF_PSEL(PWM_OUT3, 1, 5)>;	/* D4: H8 */
		};
	};

	face_pwm0_sleep: face_pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 8)>,
				<NRF_PSEL(PWM_OUT1, 1, 7)>,
				<NRF_PSEL(PWM_OUT2, 1, 6)>,
				<NRF_PSEL(PWM_OUT3, 1, 5)>;
			low-power-enable;
		};
	};

	face_pwm1_default: face_pwm1_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 4)>,	/* D3:  H16 */
				<NRF_PSEL(PWM_OUT1, 1, 15)>,	/* D13: M1 */
				<NRF_PSEL(PWM_OUT2, 1, 14)>,	/* D12: M2 */
				<NRF_PSEL(PWM_OUT3, 1, 13)>;	/* D11: M4 */
		};
	};

	face_pwm1_sleep: face_pwm1_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 4)>,
				<NRF_PSEL(PWM_OUT1, 1, 15)>,
				<NRF_PSEL(PWM_OUT2, 1, 14)>,
				<NRF_PSEL(PWM_OUT3, 1, 13)>;
			low-power-enable;
		};
	};

	face_pwm2_default: face_pwm2_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 12)>,	/* D10: M8 */
				<NRF_PSEL(PWM_OUT1, 1, 11)>,	/* D9:  M16 */
				<NRF_PSEL(PWM_OUT2, 1, 10)>;	/* D8:  M32 */
		};
	};

	face_pwm2_sleep: face_pwm2_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 1, 12)>,
				<NRF_PSEL(PWM_OUT1, 1, 11)>,
				<NRF_PSEL(PWM_OUT2, 1, 10)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&face_pwm0_default>;
	pinctrl-1 = <&face_pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm1 {
	status = "okay";
	pinctrl-0 = <&face_pwm1_default>;
	pinctrl-1 = <&face_pwm1_sleep>;
	pinctrl-names = "default", "sleep";
};

&pwm2 {
	status = "okay";
	pinctrl-0 = <&face_pwm2_default>;
	pinctrl-1 = <&face_pwm2_sleep>;
	pinctrl-names = "default", "sleep";
};

/*
 * LIS2DW12 accelerometer breakout on the Arduino I2C (i2c0: D14 = SDA P0.26,
 * D15 = SCL P0.27). The board already enables i2c0 with these pins, so we only
 * add the sensor as a child node. INT1 goes to D2 (P1.03).
 *
 * Address: 0x18, because SDO/SA0 is low on our breakout (measured). High = 0x19.
 *
 * Double-tap settings from ST's application note AN5038 (example values):
 * 400 Hz, +-2 g, threshold 12 on every axis (12 * 2 g / 32 = 750 mg),
 * shock 3, quiet 3, latency 7. At 400 Hz:
 *   shock   3 -> 3 * 8 / 400  = 60 ms   max length of one tap
 *   quiet   3 -> 3 * 4 / 400  = 30 ms   no motion right after a tap
 *   latency 7 -> 7 * 32 / 400 = 560 ms  max time between the two taps
 * Tap events can only go to INT1.
 */
&arduino_i2c {
	accel: lis2dw12@18 {
		compatible = "st,lis2dw12";
		reg = <0x18>;
		irq-gpios = <&arduino_header ARDUINO_HEADER_R3_D2 GPIO_ACTIVE_HIGH>;
		int-pin = <1>;
		range = <2>;
		odr = <400>;
		power-mode = <LIS2DW12_DT_HP_MODE>;
		low-noise;
		tap-mode = <LIS2DW12_DT_SINGLE_DOUBLE_TAP>;
		tap-threshold = <12>, <12>, <12>;
		tap-shock = <3>;
		tap-quiet = <3>;
		tap-latency = <7>;
	};
};

/*
 * Power: by default an edge interrupt uses a GPIOTE channel, which keeps a
 * high-frequency clock running in sleep. The SENSE mechanism wakes the CPU
 * on a pin level change with almost no current. P1.03 = bit 3 of gpio1.
 */
&gpio1 {
	sense-edge-mask = <(1 << 3)>;
};

/*
 * The board's own "leds" node uses the same pins (LED1-LED4). Disable it, so
 * only one LED driver owns P0.13 and P0.14.
 */
&{/leds} {
	status = "disabled";
};

/*
 * Heartbeat: a red and a green LED that flash once a minute, showing the
 * battery level. Plain GPIOs, no PWM: on the watch the low brightness comes
 * from the resistors.
 * Child order = LED index used in heartbeat.c: 0 red, 1 green.
 *
 * DK: the DK's own LEDs stand in for them (both are green on the board):
 *   green = LED1 (P0.13), red = LED2 (P0.14). They are wired from VDD to the
 *   pin, so they light when the pin is low: GPIO_ACTIVE_LOW. The LED API
 *   hides this: led_on() still means "on".
 */
/ {
	status_led: status_led {
		compatible = "gpio-leds";

		status_red   { gpios = <&gpio0 14 GPIO_ACTIVE_LOW>; label = "Status red"; };   /* DK LED2 */
		status_green { gpios = <&gpio0 13 GPIO_ACTIVE_LOW>; label = "Status green"; }; /* DK LED1 */
	};

	/*
	 * Battery voltage through a divider: VBAT -[1M]- AIN -[1M]- GND, with
	 * 100 nF from AIN to GND. Always on: 4.2 V / 2 MOhm = 2.1 uA.
	 * The driver multiplies the ADC reading by full-ohms / output-ohms = 2.
	 * DK: no battery; a potentiometer (VDD..GND) on A0 stands in for VBAT / 2.
	 */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 0>;
		output-ohms = <1000000>;
		full-ohms = <(1000000 + 1000000)>;
	};
};

/*
 * SAADC channel 0 on AIN1 = P0.03 = Arduino A0.
 * Gain 1/6 with the 0.6 V internal reference = 3.6 V full scale.
 * The divider is high-impedance (500 kOhm seen by the ADC), so it needs
 * the long 40 us acquisition time (the 100 nF also helps).
 * Oversampling 2 = each result is the average of 2^2 = 4 conversions, to
 * smooth out noise (about 4 x 42 us, still far below 1 ms).
 */
&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <2>;
	};
};
