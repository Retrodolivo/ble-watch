{
    // Machine-specific paths come from environment variables, which VS Code
    // reads once at start-up (see docs/learn/vscode-env.md):
    //   ZEPHYR_BASE             e.g. ~/ncs/v3.4.2/zephyr
    //   ZEPHYR_SDK_INSTALL_DIR  e.g. ~/zephyr-sdk-1.0.1
    // JLinkGDBServerCLExe is found on the PATH.
    "version": "0.2.0",
    "configurations": [
        {
            // Flash MCUboot + the signed app, reset and stop at main().
            // Symbols come from zephyr.elf, but we must not flash it: it has no
            // MCUboot header, so MCUboot would refuse to boot it.
            "name": "J-Link: flash and debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "device": "nRF52840_xxAA",
            "interface": "swd",
            "showDevDebugOutput": "raw",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/app/zephyr/zephyr.elf",
            "loadFiles": [
                "${workspaceFolder}/build/mcuboot/zephyr/zephyr.hex",
                "${workspaceFolder}/build/app/zephyr/zephyr.signed.hex"
            ],
            "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "svdFile": "${env:ZEPHYR_BASE}/../modules/hal/nordic/nrfx/bsp/stable/mdk/nrf52840.svd",
            "rtos": "Zephyr",
            "runToEntryPoint": "main"
        },
        {
            // Connect to the running firmware without flashing or resetting.
            "name": "J-Link: attach",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "jlink",
            "device": "nRF52840_xxAA",
            "interface": "swd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/app/zephyr/zephyr.elf",
            "gdbPath": "${env:ZEPHYR_SDK_INSTALL_DIR}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
            "svdFile": "${env:ZEPHYR_BASE}/../modules/hal/nordic/nrfx/bsp/stable/mdk/nrf52840.svd",
            "rtos": "Zephyr"
        }
    ]
}
